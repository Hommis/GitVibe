# .gitignore for a .NET project

# Ignore build outputs
bin/
obj/

# Ignore user-specific files
*.user
*.rsuser
*.suo
*.userosscache
*.sln.docstates

# Ignore Visual Studio Code settings
.vscode/

# Ignore Avalonia specific files
*.axaml.cs

# Ignore other common files
*.log
*.lock.json
*.pdb
*.cache
*.ide
*.DS_Store
*.directory